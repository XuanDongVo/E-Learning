# Copy to .env.prod (ignored). NEVER commit actual production values.
# For a real deployment, serve the browser over HTTPS and use exact trusted origins.
SPRING_PROFILES_ACTIVE=prod
DB_URL=jdbc:postgresql://db:5432/e_learning
DB_USERNAME=e_learning_app
DB_PASSWORD=replace_with_unique_strong_password
JWT_BASE64_SECRET=replace_with_unique_base64_encoded_32_plus_byte_secret
JWT_ACCESS_TOKEN_EXPIRE=3600
JWT_REFRESH_TOKEN_EXPIRE=604800
JWT_COOKIE_SECURE=true
CORS_ALLOWED_ORIGINS=https://learn.example.com
CLOUD_NAME=replace_with_prod_cloud_name
API_KEY=replace_with_prod_cloudinary_key
API_SECRET=replace_with_prod_cloudinary_secret
ACTIVITY_XP_ENABLED=true
# NEXT_PUBLIC_API_URL is intentionally unset for same-origin /v1/* routing.
# Reverse proxy /v1/* -> backend:8080 will be configured in phase 3.
