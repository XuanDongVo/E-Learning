# Copy to .env.dev (ignored); load into your shell or IDE before launching Spring Boot.
SPRING_PROFILES_ACTIVE=dev
DB_URL=jdbc:postgresql://localhost:5432/e_learning
DB_USERNAME=postgres
DB_PASSWORD=replace_with_local_database_password
JWT_BASE64_SECRET=replace_with_unique_base64_encoded_32_plus_byte_secret
JWT_ACCESS_TOKEN_EXPIRE=3600
JWT_REFRESH_TOKEN_EXPIRE=604800
JWT_COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
CLOUD_NAME=replace_with_dev_cloud_name
API_KEY=replace_with_dev_cloudinary_key
API_SECRET=replace_with_dev_cloudinary_secret
ACTIVITY_XP_ENABLED=true
